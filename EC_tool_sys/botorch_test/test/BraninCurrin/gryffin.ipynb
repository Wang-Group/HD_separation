    "descriptors = {\"0\": None, \n",
    "               \"1\": None, \n",
    "               \"2\": None}\n",
    "config = {\n",
    "    \"general\": {\n",
    "        \"random_seed\": 42,\n",
    "        \"verbosity\": 0,\n",
    "        \"boosted\":  True,\n",
    "        \"num_cpus\": 100\n",
    "    },\n",
    "    \"parameters\": [\n",
    "        {\"name\": \"x_0\", \"type\": \"continuous\", \"low\": 0.0, \"high\": 1.0},\n",
    "        {\"name\": \"x_1\", \"type\": \"continuous\", \"low\": 0.0, \"high\": 1.0},\n",
    "        {\"name\": \"c_0\", \"type\": \"categorical\", 'options': [\"0\", \"1\", \"2\"], 'category_details': descriptors},\n",
    "        {\"name\": \"c_1\", \"type\": \"categorical\", 'options': [\"0\", \"1\", \"2\"], 'category_details': descriptors}\n",
    "    ],\n",
    "    \"objectives\": [\n",
    "        {\"name\": \"obj1\", \"goal\": \"max\", \"tolerance\": 0.5, \"absolute\": False},\n",
    "        {\"name\": \"obj2\", \"goal\": \"max\", \"tolerance\": 0.2, \"absolute\": False},\n",
    "    ]\n",
    "}"
   ]
